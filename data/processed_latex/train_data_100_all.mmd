\begin{lemma}
    We have, for all measurable functions $f$ and $g$
    \[\mathbb{E}[f(H_{N;j})g(H_{N;k})]=\int_{G^2}f(x)g(yx)f_{H_{N;j}}(x)p_{N}(y)\dd x \dd y,\]
    where 
    \[p_{N}(y)=\sum_{\lambda \in \widehat{G}} \Bigg(\prod_{\substack{j\leq r\leq k \\ \theta\in\Theta^N_-}} \frac{\widehat{\mu}_{\sigma(\square(t,t_+m\theta,\theta_+))}}{d_\lambda} \Bigg) \chi_\lambda(y). \]
\end{lemma}
As a result, we get the desired conditional law. 
\begin{lemma}
      We have, for all measurable functions $f$
      \[\mathbb{E}[f(H_{N;j})|H_{N;k}]=\int_Gf(x) \kappa_N (H_{N;k},x)\dd x, \text{ where } \kappa_n(g,x)\coloneq \frac{f_{H_{N;j}}(x)p_{N}(gx^{-1})}{f_{H_{N;k}}(g)}.\]
