    \title[A Variational Principle for the Topological Pressure of Non-autonomous Iterated Function Systems on Subsets]{A Variational Principle for the Topological Pressure of Non-autonomous Iterated Function Systems on Subsets}










\author*[1]{\fnm{Yujun} \sur{Ju}} \email{yjju@ctbu.edu.cn}

\equalcont{These authors contributed equally to this work.}

\author[1]{\fnm{Lingbing} \sur{Yang}} \email{yanglingbing@ctbu.edu.cn}

\affil[1]{\orgdiv{School of Mathematics and Statistics}, \orgname{Chongqing Technology and Business University}, \orgaddress{\city{Chongqing}, \postcode{400067}, \country{People's Republic of China}}}
