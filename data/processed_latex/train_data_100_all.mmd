    \end{aligned}
    \end{equation}
    where $\phi^{\epsilon}_k(r)=\mathbf{1}_{[0,T]}(r)e^{r\lambda_k\epsilon^{-1}}|\lambda_k|\epsilon^{-1}.$\\
