subsection{Discussion old}

One surprizing fact from the proof of \Cref{thm:sobolev_to_switches} is that we only applied Maurey's method in time for approximating the flow and then we could control the divergence without imposing any other structure on the map as we do in \Cref{thm: gen.thm}. However the structure is already imposed with the law chosen. Furthermore, the proof only works for the ReLU and the variants that we will discuss here. Indeed, if the activation function was $\sigma(s)=\sin(s)$ or $\sigma(s)=\tanh(s)$, for instance, we could not obtain a uniform control on the log jacobian.  

\begin{enumerate}
    \item \noindent\textbf{Maurey's map approximation in general does not imply \ $\mathsf{TV}$ approximation.}
Controlling the endpoint map $X(1,\cdot)-Y(1,\cdot)$ in $L^2(\Omega)$ is essentially a stability statement for characteristics and only
requires that $u_N$ approximates $u$ in a norm strong enough along trajectories.
In contrast, $\mathsf{TV}$ control of pushforwards is governed by \emph{compressibility}:
if $X(t,\cdot)$ is the flow of $\dot x=u(x)$ (for simplicity autonomous), then
\begin{align*}
q_X(t,x)\coloneqq \log\det\nabla_x X(t,x)
\quad\text{satisfies}\\
\partial_t q_X(t,x) = (\nabla\cdot u)(X(t,x)),
\qquad q_X(0,x)=0,
\end{align*}
so $\mathsf{TV}$ estimates require quantitative control of $\nabla\cdot u_N$ \emph{along the approximate trajectories}.
A concrete 1D example on the circle $\mathbb T=\mathbb R/(2\pi\mathbb Z)$ is
\[
u_n(x)=\frac1n\sin(nx).
\]
Since $\|u_n\|_{L^\infty}\le 1/n$, the time--$1$ flow $\Phi_n$ satisfies
$\|\Phi_n-\mathsf{id}\|_{L^\infty}\le \int_0^1 \|u_n\|_{L^\infty}\,dt \le 1/n$, hence $\Phi_n\to\mathsf{id}$ uniformly.
However, the Jacobian does not converge to $1$.
Indeed, the ODE $\dot x=\frac1n\sin(nx)$ can be solved explicitly via the change of variables
\[
z(t)\coloneqq \tan\left(\frac{n}{2}x(t)\right).
\]
Using the trigonometric identity $\sin\theta = \frac{2\tan(\theta/2)}{1+\tan^2(\theta/2)}$ we obtain
\begin{align*}
    \dot z(t)
&=\frac{n}{2}\left(1+z(t)^2\right)\dot x(t)
=\frac{n}{2}\left(1+z(t)^2\right)\frac1n\sin\left(nx(t)\right)\\
&=\frac12\left(1+z(t)^2\right)\frac{2z(t)}{1+z(t)^2}
=z(t).
\end{align*}
Hence $z(t)=e^{t}z(0)$, and at time $t=1$ we have the \emph{implicit} formula
\begin{equation}\label{eq:tan-conjugacy}
\tan\left(\frac{n}{2}\Phi_n(x)\right)= e\,\tan\left(\frac{n}{2}x\right).
\end{equation}
Differentiating \eqref{eq:tan-conjugacy} in $x$ yields
\[
\frac{n}{2}\Phi_n'(x)\sec^2\left(\frac{n}{2}\Phi_n(x)\right)
=
e\,\frac{n}{2}\sec^2\left(\frac{n}{2}x\right),
\]
so
\[
\Phi_n'(x)
=
e\,
\frac{\sec^2(\frac{n}{2}x)}{\sec^2(\frac{n}{2}\Phi_n(x))}
=
e\,
\frac{1+\tan^2(\frac{n}{2}x)}{1+\tan^2(\frac{n}{2}\Phi_n(x))}
=
e\,
\frac{1+\tan^2(\frac{n}{2}x)}{1+e^2\tan^2(\frac{n}{2}x)}.
\]
Rewriting in terms of $\sin$ and $\cos$ gives the convenient closed form
\begin{equation}\label{eq:Phi-derivative-explicit}
\Phi_n'(x)
=
\frac{e}{\cos^2(\frac{n}{2}x)+e^2\sin^2(\frac{n}{2}x)}.
\end{equation}
Since $\cos^2(\cdot)+e^2\sin^2(\cdot)$ ranges between $1$  and $e^2$,
\eqref{eq:Phi-derivative-explicit} implies $\max_x \Phi_n'(x)=e$ and $
\min_x \Phi_n'(x)=e^{-1}$.
Thus the Jacobian determinant does \emph{not} approach $1$ although the displacement $\|\Phi_n-\mathsf{id}\|_{L^\infty}$ goes to $0$.
In particular, for Lebesgue measure $\lambda$ on $\mathbb T$ one checks (by the change of variables $y=\Phi_n(x)$) that
\[
\left|\lambda-\Phi_{n\#}\lambda\right|_{\mathsf{TV}}
=
\int_{\mathbb T}\Big|\frac{\diff (\Phi_{n\#}\lambda)}{\diff \lambda}(y)-1\Big|\diff y
=
\int_{\mathbb T}|\Phi_n'(x)-1|\diff x,
\]
and the right-hand side is a strictly positive constant independent of $n$ because $\Phi_n'$ has the same profile at frequency $n$.
This illustrates the general principle: \emph{approximating the map does not force the Jacobian (hence the pushforward in $\mathsf{TV}$) to be close.}


\item 

\noindent\textbf{The same Barron norm does not suffice for other activation functions.}
For a general activation $\sigma$ and a single-neuron vector field
\[
v_\theta(x)=w\,\sigma(a\cdot x+b),
\qquad \theta=(w,a,b)\in\mathbb R^{2d+1},
\]
the divergence is obtained by the chain rule:
\[
\nabla\cdot v_\theta(x)
=
\sum_{i=1}^d \partial_{x_i}\left(w_i\,\sigma(a\cdot x+b)\right)
=
\sum_{i=1}^d w_i\,\sigma'(a\cdot x+b)\,a_i
=
(w\cdot a)\,\sigma'(a\cdot x+b).
\]
Compared with the size of the field itself (typically controlled by $|w|$ times a bound on $|\sigma|$),
the divergence contains an \emph{extra factor} $|a|$ through $|w\cdot a|\le |w|\,|a|$:
\[
|\nabla\cdot v_\theta(x)|
\le |w|\,|a|\,\|\sigma'\|_{L^\infty(\mathbb R)}.
\]
This is exactly the quantity that drives the log--Jacobian $q(t,x)=\log\det\nabla X(t,x)$.
In the probabilistic/Maurey proof, the martingale step (
 \eqref{eq:step3-eta-var-rigorous} ) requires the corresponding \emph{normalized divergence atoms}
to have a uniform $L^\infty$ bound (or at least finite second moment under the sampling law).
If one chooses a cost that only controls the velocity atoms (e.g.\ $c(\theta)=|w|$ for bounded $\sigma$),
then the normalized divergence atom looks like
\[
\frac{\nabla\cdot v_\theta(x)}{c(\theta)}
=
\frac{(w\cdot a)\,\sigma'(a\cdot x+b)}{|w|}
=
\left(\frac{w}{|w|}\cdot a\right)\sigma'(a\cdot x+b),
\]
which can be arbitrarily large when $|a|$ is large, so the variance bound behind \eqref{eq:step3-eta-var-rigorous} can fail.
Moreover, even if one manages to control $\nabla\cdot u_N$ pointwise, for smooth $\sigma$ one typically also needs to control
the \emph{spatial Lipschitz constant} of the divergence in order to bound the analogue of the remainder term
$R_k^Y$ that appears in the flow recursion (Step~3.4(a) and \eqref{eq:step3-Rk-bound-rigorous} in your draft):
for general $\sigma$,
\[
\nabla_x\left(\nabla\cdot v_\theta(x)\right)
=
(w\cdot a)\,\sigma''(a\cdot x+b)\,a,
\]
hence
\[
\|\nabla_x(\nabla\cdot v_\theta)\|_{L^\infty}
\le |w|\,|a|^2\,\|\sigma''\|_{L^\infty}.
\]
This is the origin of the ``$|a|^2$'' remark: controlling time-discretization errors for the log--Jacobian generally forces
a moment/cost that pays not only for $|w|\,|a|$ but also (through $\sigma''$) for $|w|\,|a|^2$.
ReLU avoids this issue because $\sigma'(s)=\mathbf 1_{\{s>0\}}$ is piecewise constant, and in the ReLU case the log--Jacobian update
along a frozen neuron is \emph{exact} (see \eqref{eq:qY_increment_exact} in your draft), so no $\sigma''$--type remainder appears.

\medskip
\noindent\textbf{A concrete $\tanh$ pathology}
Let $d=1$, $\Omega=[-1,1]$, and $\sigma(s)=\tanh(s)$.
Define a probability law for a random slope $A\ge 1$ by prescribing its density
\[
p(a)\coloneqq \frac{1}{a^2}\,\mathbf 1_{\{a\ge 1\}},
\qquad\text{so that}\qquad
\int_1^\infty p(a)\,da=\int_1^\infty \frac{1}{a^2}\,da=1.
\]
(Equivalently, $\mathbb P(A\ge a)=1/a$ for $a\ge 1$.)
For each $a\ge 1$ set the weight $w(a)\coloneqq 1/a$ and consider the scalar field
\[
u(x)\coloneqq \mathbb E\Big[\frac{1}{A}\tanh(Ax)\Big]
=
\int_1^\infty \frac{1}{a}\tanh(ax)\,p(a)\,da
=
\int_1^\infty \frac{\tanh(ax)}{a^3}\,da.
\]
Since $|\tanh|\le 1$, this is well-defined and bounded:
\[
|u(x)|\le \mathbb E\Big[\frac1A\Big]
=
\int_1^\infty \frac{1}{a}\,p(a)\,da
=
\int_1^\infty \frac{1}{a^3}\,da
=\frac12.
\]
Now mimic the \emph{naive} Maurey/Barron normalization one might use for \emph{bounded} activations when only the map observable matters:
take the cost $c(a)=|w(a)|=1/a$ (no penalty on $a$), so that the cost-weighted measure has density
\[
M(da)=c(a)\,p(a)\,da=\frac{1}{a^3}\,da,
\qquad
r\coloneqq M([1,\infty))=\int_1^\infty \frac{1}{a^3}\,da=\frac12,
\]
and the associated sampling law is
\[
\nu(da)\coloneqq \frac{1}{r}M(da)=\frac{2}{a^3}\,da.
\]
With this choice, the representation rewrites as
\[
u(x)=r\,\mathbb E_\nu[\tanh(Ax)],
\]
and because $|\tanh(Ax)|\le 1$ for all $A$ and $x\in\Omega$, the Monte--Carlo estimator
\[
u_N(x)\coloneqq \frac{r}{N}\sum_{i=1}^N \tanh(A_i x),
\qquad A_i\overset{\text{i.i.d.}}{\sim}\nu,
\]
approximates $u$ in $L^2(\Omega)$ with the usual $N^{-1/2}$ rate (variance bounded by $r^2$).
In other words, \emph{Maurey works perfectly well for the map-driving observable $u$}.

However, the divergence observable is the derivative:
\[
u'(x)=\mathbb E\big[\tanh'(Ax)\big]
=\mathbb E\big[\mathrm{sech}^2(Ax)\big]\le 1,
\]
while
\[
u_N'(x)=\frac{r}{N}\sum_{i=1}^N A_i\,\mathrm{sech}^2(A_i x),
\qquad\text{hence in particular}\qquad
u_N'(0)=\frac{r}{N}\sum_{i=1}^N A_i.
\]
Under $\nu(da)=2a^{-3}da$ we have an \emph{infinite second moment}:
\[
\mathbb E_\nu[A^2]
=
\int_1^\infty a^2\,\frac{2}{a^3}\,da
=
2\int_1^\infty \frac{1}{a}\,da
=+\infty.
\]
Consequently,
\[
\mathbb E\big[(u_N'(0))^2\big]
\;\ge\;
\frac{r^2}{N^2}\,\mathbb E_\nu[A_1^2]
=+\infty,
\]
so the basic conditional variance estimate needed to control martingale increments for the log--Jacobian
(the analogue of \eqref{eq:step3-eta-var-rigorous}, but for the divergence increments) fails completely.
Thus one can have an $L^2$--accurate approximation of the velocity field (hence good control of the endpoint map)
while the divergence estimator has uncontrolled fluctuations, preventing quantitative control of $\log\det\nabla Y(1,\cdot)$ and therefore of $\mathsf{TV}$.
This shows concretely why, for $\tanh$/sigmoid, \emph{the same Maurey scheme used for the map does not automatically provide $\mathsf{TV}$ control} unless the normalization/sampling is modified to pay for the divergence observable (at least $|w|\,|a|$, and for time-discretization remainders typically also $|w|\,|a|^2$ through $\sigma''$).



\item 
\noindent\textbf{ ReLU-based Maurey construction controls both the map error and $\mathsf{TV}$.}
In the ReLU case $\sigma(s)=s_+$, the divergence atom is
\[
\nabla\cdot\left(w(a\cdot x+b)_+\right)=(w\cdot a)\mathbf 1_{\{a\cdot x+b>0\}},
\]
and on the confinement set $\widetilde\Omega$ we choose the cost (Step~3.1 in your draft)
\[
c(\theta)=|w|\,(R|a|+|b|),
\]
which yields normalized atoms
\[
g_\theta(x)=\frac{w(a\cdot x+b)_+}{c(\theta)},\qquad
h_\theta(x)=\frac{(w\cdot a)\mathbf 1_{\{a\cdot x+b>0\}}}{c(\theta)}.
\]
By construction $|g_\theta|\le 1$ on $\widetilde\Omega$ and also $|h_\theta|\le 1/R$, so the \emph{same} cost simultaneously bounds
the velocity atoms and the divergence atoms, allowing the martingale variance bounds in Step~3.4(b) (cf.\ \eqref{eq:step3-eta-var-rigorous}) to be applied to \emph{both} observables.
Moreover, the specific ReLU geometry implies that on each time-interval with frozen parameters the sign of $a\cdot Y(t,x)+b$ cannot change along a characteristic,
so $(\nabla\cdot u_N)(t,Y(t,x))$ is constant in $t$ on that interval and the log--Jacobian update is \emph{exact} (cf.\ \eqref{eq:qY_increment_exact}).
Finally, the Sobolev assumption $s>d/2+2$ makes $\nabla\cdot u(t,\cdot)$ Lipschitz on $\widetilde\Omega$, so one can compare $(\nabla\cdot u)(t,X)$ and $(\nabla\cdot u)(t,Y)$
and close the Gr\"onwall argument.
These three ingredients---a cost that bounds both $g_\theta$ and $h_\theta$, a sampling law that makes both estimators unbiased,
and the ReLU interval-exactness of the divergence along trajectories---are what allow one to control \emph{simultaneously} the map error and the pushforward in $\mathsf{TV}$.





\end{enumerate}








On the other hand, \Cref{thm: gen.thm} is based on  a polar-like decomposition of the maps. Even if we proved the results for the ReLU, the methods can be extended to other activation functions provided that:
\begin{enumerate}
    \item One is able to adapt \Cref{lem: mp.neural.ode.swap}.
    \item One is able to adapt \Cref{lem: 1d} even allowing some small error at the kinks (this will incur a small error in the $\mathsf{TV}$ norm when making the push-forward, but it is necessary for smooth activation functions).
\end{enumerate}
On the other hand, if one goes to generalize the method on \Cref{thm:sobolev_to_switches_TV}, a deeper thought on what norm is consiered or what strucutral assumptions are imposed to the flow so that one is able to approximate the vector field and the divergence at the same time.



