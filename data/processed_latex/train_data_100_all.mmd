Let $\Omega$ be a open subset of $\mathbb{C}$ and $\varphi$ be a complex valued function on $\Omega.$ If $\varphi$ is continuous on $\Omega$ and the Laplacian of $\varphi$ is zero at every point of $\Omega,$ then $\varphi$ is said to be harmonic in $\Omega.$ Throughout this article $\varphi$ is harmonic stands for $\varphi$ is harmonic in $\mathbb{D}.$



\begin{cor}

	Let $\varphi$ be a univalent holomorphic self-map on $\mathbb{D}$ with fixed point in $\mathbb D$ and $\varphi'' \in \text{H}^{\infty}(\mathbb D).$ Let $\psi \in Hol(\mathbb D)$ satisfy $\lim_{|z|\to 1^-}|\psi''(z)|(1-|z|^2)=0.$ If $\lim_{|z|\to 1^-}|\psi(z)|\left(\frac{1-|z|^2}{1-|\varphi(z)|^2}\right)^{\frac{\alpha}{2}+1}=0$ for any $\alpha \in (-1,1)$ then $C_{\psi,\varphi}$ is in every Schatten $p$-class, $p>0,$ of $\mathcal{D}_{\beta}$ for all $\alpha \leq \beta <1.$

\end{cor}



\begin{proof}

	Step 1: First we prove this result for $\alpha.$

	Suppose that $\varphi$ and $\psi$ satisfy the stated conditions for some $\alpha \in (-1,1).$ Let $a \in \mathbb D$ be the fixed point of $\varphi.$ Then, by Theorem \ref{SPMT1}, we obtain $0<|\varphi'(a)|<1$ and $$\sigma(C_{\psi,\varphi};\mathcal{D}_{\alpha})=\left\{\psi(a)(\varphi'(a))^n: n \in \mathbb N \cup \{0\} \right\}\cup \{0\}.$$

	Thus for any $p>0,$ the Schatten $p$-norm of $C_{\psi,\varphi}$ is

	\begin{align*}

		\|C_{\psi,\varphi}\|_p=\left( \sum^{\infty}_{n=0} |\psi(a)|^p|\varphi'(a)|^{np} \right)^{1/p}=\frac{|\psi(a)|}{(1-|\varphi'(a)|^{p})^{1/p}}<\infty.

	\end{align*}

	Thus, $C_{\psi,\varphi}$ is in every Schatten $p$-class of $\mathcal{D}_{\alpha}.$\\

	Step 2: Now, we prove for all $\beta$ with $\alpha < \beta <1.$ Consider the functions $\zeta=\psi \circ \varphi_a$ and $\eta=\varphi_a\circ \varphi \circ \varphi_a.$ Proceeding as in Proposition \ref{SPT1}, we conclude that $\zeta$ and $\eta$ also satisfy the stated conditions.

	Since $\eta(0)=0$, the Schwarz Lemma implies that 

	$$1-|z|^2\leq 1-|\eta(z)|^2,~~\text{for all $z \in \mathbb{D}.$}$$

	Consequently, for all $\alpha < \beta <1,$  

	$$|\zeta(z)|\left(\frac{1-|z|^2}{1-|\eta(z)|^2}\right)^{\frac{\beta}{2}+1}\leq |\zeta(z)|\left(\frac{1-|z|^2}{1-|\eta(z)|^2}\right)^{\frac{\alpha}{2}+1}.$$

	This yields

	$$\lim_{|z|\to 1^-}|\zeta(z)|\left(\frac{1-|z|^2}{1-|\eta(z)|^2}\right)^{\frac{\beta}{2}+1}=0,~~\text{for all $\alpha < \beta <1$}.$$

	Therefore, by Theorem \ref{SPMT1}, for every $\alpha < \beta <1,$

	\begin{align*}

		\sigma(C_{\psi,\varphi};\mathcal{D}_{\beta})=\sigma(C_{\zeta,\eta};\mathcal{D}_{\beta})=

		\left\{\psi(a)(\varphi'(a))^n: n \in \mathbb N \cup \{0\} \right\}.

	\end{align*}

	Hence, the Schatten $p$-norm of $C_{\psi,\varphi}$ is finite, and consequently $C_{\psi,\varphi}$ belongs to every Schatten $p$-class, $p>0,$ of $\mathcal{D}_{\beta}$ for all $\alpha \leq \beta <1.$

\end{proof}



