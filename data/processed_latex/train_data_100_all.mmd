\center{\includegraphics[width=0.7\linewidth]{qq=0,3.eps}} \\
$\zeta=0.3$
\end{minipage}
\begin{minipage}[h]{0.3\linewidth}
\center{\includegraphics[width=0.7\linewidth]{qq=0,6.eps}} \\
$\zeta=0.6$
\end{minipage}
