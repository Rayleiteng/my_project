\begin{proof}
Since
\begin{align*}
|T(x)_n|&\leq \sum_{m\geq 0}|a_{n,m}||x_m| = \sum_{m\geq 0}|a_{n,m}\frac{q_m}{p_n}||x_m \frac{p_n}{q_m}|\\
&\leq \left(\sum_{m\geq 0}\left|a_{n,m}\frac{q_m}{p_n}\right|\right)^\ft\left(\sum_{m\geq 0} \left|a_{n,m}\frac{q_m}{p_n}\right|\left|x_m \frac{p_n}{q_m}\right|^2\right)^\ft,\qquad\text{(Cauchy-Schwartz)}
\end{align*}
we have
\begin{align*}
\sum_{n\geq 0} |T(x)_n|^2 \leq M \sum_{n,m\geq 0} |a_{n,m}||x_m|^2 \frac{p_n}{q_m}\leq MN \sum_{m \geq 0}|x_m|^2.
\end{align*}
\end{proof}

