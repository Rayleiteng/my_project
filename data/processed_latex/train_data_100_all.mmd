def harmonicSWIP(self, mobility):
    delta = Constant(1e-14, name="deltaMobility")
    def weightedAverage(c, mobilityWeightArg, mobilityWithArg, gradChemical):
        denom = max_value(bo.oplus(mobility(mobilityWeightArg("+"))) + bo.oplus(mobility(mobilityWeightArg("-"))), delta)

        return ( mobilityWithArg("+") * gradChemical("+") * mobility(mobilityWeightArg("-")) + mobilityWithArg("-") * gradChemical("-") * mobility(mobilityWeightArg("+"))) / denom

    penalty = lambda c: self.PenaltyDG / self.he

    return lambda upsilon, psi, v, psiWeight: (
        penalty(psi) * jump(upsilon) * jump(v)
        - inner(weightedAverage(psi, psiWeight, mobility(psi), grad(upsilon)), jump(v, self.n))
        - self.theta * inner(weightedAverage(psi, psiWeight, mobility(psi), grad(v)), jump(upsilon, self.n))
    ) * dS
