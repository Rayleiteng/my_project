		\noindent{\bf Keywords:} Integrodifferential equations;  Critical nonlinearities;  Local well-posedness; Continuation and blow-up alternative; Regularity theory; Navier-Stokes with hereditary viscosity; Reaction-diffusion with memory.
		
	\end{abstract}
	
	
