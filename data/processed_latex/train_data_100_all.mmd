    \begin{aligned}
        R^{\epsilon}(x,t)&=e^{-\frac{t}{2\epsilon}}\Big[\frac{1}{2\sqrt{\pi \epsilon t}}\int_0^\infty \Big\{e^{-\frac{(x-\xi)^2}{4\epsilon t}}-e^{-\frac{(x+\xi)^2}{4\epsilon t}}\Big\}\theta^{\epsilon}_0(\xi)d\xi\\
        &+ \frac{x}{2 \sqrt{\pi \epsilon}}\int_0^t \frac{g(\tau)}{(t-\tau)^{\frac{3}{2}}}e^{-\frac{1}{2 \epsilon}\Big[ \frac{x^2}{2(t-\tau)}-\tau\Big]} d\tau\Big]\\
        &=e^{-\frac{t}{2\epsilon}}[R_1^{\epsilon}(x,t) +R_2^{\epsilon}(x,t)].
