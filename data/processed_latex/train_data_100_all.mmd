     & -\frac{x g(0)}{4 \pi^{\frac{3}{2}} \epsilon^{\frac{1}{2}}}  \int_0^t \int_0^\tau \int_0^1  \frac{1}{ u^{\frac{1}{2}} (\tau-u)^{\frac{1}{2}}(t-\tau)^{\frac{3}{2}}}e^{-\frac{1}{2 \epsilon}\Big[ \frac{x^2}{2(t-\tau)}+(\theta-1) u\Big]} d\theta du d\tau\\
