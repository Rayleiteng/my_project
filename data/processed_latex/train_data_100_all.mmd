\title{iGRPO: Self‑Feedback–Driven LLM Reasoning}











\author{Ali Hatamizadeh\footnote[1]{Project lead. Correspondence to: Ali Hatamizadeh<ahatamizadeh@nvidia.com>.}, Shrimai Prabhumoye, Igor Gitman, Ximing Lu, Seungju Han, Wei Ping, Yejin Choi, Jan Kautz\\
}










