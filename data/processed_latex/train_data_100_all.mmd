  innerrightmargin=.1cm,innertopmargin=-.1cm,innerbottommargin=0.1cm]
\begin{remark}
\label{remark:decoder-curv}
    In constrast to~\eqref{eq:latent_closed_loop_dyns}, the disturbances $\tilde\Delta_{\theta}$ and $\tilde\Delta_{\perp}$ in~\eqref{eq:tilde_closed_loop_dyns} also depend on the decoder curvature via $d^2\varphiq$.
\end{remark}
\end{mdframed}
