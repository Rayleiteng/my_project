      & \Bigg[ \frac{1}{2(\epsilon (\tau-u))^{\frac{3}{2}}}\int_0^{\infty}\Big[e^{-\frac{(\tau-u)}{2\epsilon}}\theta^{\epsilon}_0(\xi)+\theta^{\epsilon}_0(-\xi)\Big]\xi e^{-\frac{\xi^2}{4\epsilon (\tau-u)}}d\xi-\frac{g(0)}{\sqrt{\epsilon (\tau-u)}}\Big(e^{-\frac{(\tau-u)}{2\epsilon}}+1\Big)\Bigg]\mathrm{d}u \mathrm{d}\tau\\
      &= \frac{x}{(4 \pi \epsilon)^{\frac{3}{2}}} \int_0^t \int_0^\tau \int_0^1 \int_{0}^{\infty}
