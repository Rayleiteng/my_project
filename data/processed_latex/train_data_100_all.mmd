    \includegraphics[scale=0.7]{Figures/perm-1.pdf}
    \quad \raisebox{1cm}{\(\xmapsto{\hspace{0.2cm}m\hspace{0.2cm}}\)} \quad\includegraphics[scale=0.46]{Figures/perm-5.pdf}
