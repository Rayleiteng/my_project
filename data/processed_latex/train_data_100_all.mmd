\title{Empirical Bayes Variable Selection with Lasso Statistics in the AMP Framework}








\author{
Lina Hidmi \qquad\qquad Asaf Weinstein\\[0.6em]
{\em Hebrew University of Jerusalem}\thanks{Emails: lina.hidmi@mail.huji.ac.il, asaf.weinstein@mail.huji.ac.il}\\[1em]
}

