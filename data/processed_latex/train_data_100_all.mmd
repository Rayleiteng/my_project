\begin{proof}[Proof of Remark \ref{rmk: strong rate}]

We define the following events for $B,C>0$
\begin{align*}
    E_n&:=\left\{\ell_{\alpha}(\tilde{S}_{t,T},S_{t,T})\leq \frac{C\log^2(1+r)}{t^{\alpha}}\right\}, \\
    B_n&:=\left\{\left|\hat{\alpha}_n-\alpha\right|^2\leq B t^{-\alpha}\right\}, \\
    A_n&:=\left\{\log(1+r)\leq c_0t^{\frac{\hat{\alpha}_n}{2}}\right\}.
\end{align*}
Our goal is to show that for any $\epsilon>0$, there are $B,C>0$ such that $\IP(E_n^c)<\epsilon$.
Let hence $\epsilon>0$ be arbitrary but fixed. By Theorem \ref{thm: alpha-rate}, there is $B>0$ such that $\IP(B_n^c)\leq\frac{\epsilon}{6}$.

We begin by considering the case $\log(1+r)\leq2c_0t^{\frac{\alpha}{2}}$ first. We have
\begin{align}
\IP(E_n^c)\leq&\IP(E_n^c\cap A_n^c)+\IP(E_n^c\cap A_n) \nonumber \\
\leq&\IP(E_n^c\cap A_n^c\cap B_n)+\IP(E_n^c\cap A_n\cap B_n)+2\IP(B_n^c). \label{eq:mainUB}
\end{align}
We have already argued that $2\IP(B_n^c)\leq\frac{\epsilon}{3}$. In the following, we will show that also the remaining two probabilities can be bounded from above by $\frac{\epsilon}{3}$.

We continue with $\IP(E_n^c\cap A_n\cap B_n)$. Similarly as in \cite{favaro_2023_nearoptimal},  we rewrite
\begin{align}
&\left|\hat{S}_{t,T}-S_{t,T}\right| \nonumber \\
=&\left|S_t((1+r)^{\hat{\alpha}}-1)-(S_T-S_t)\right| \nonumber \\
=&\left|S_t(1+r)^\alpha\left((1+r)^{\hat{\alpha}-\alpha}-1\right)+\left(S_t(1+r)^{\alpha}-S_T\right)\right| \nonumber \\
\leq&S_t(1+r)^\alpha\log(1+r)\sup_{a\in[\hat{\alpha},\alpha]}e^{\log(1+r)(a-\alpha)}\left|\hat{\alpha}-\alpha\right|+\left|\left(S_t(1+r)^{\alpha}-S_T\right)\right|. \label{eq:split1}
\end{align}
On the event $B_n$, the first term above is bounded by
\begin{align}
&S_t(1+r)^\alpha\log(1+r)\sup_{a\in[\hat{\alpha},\alpha]}e^{\log(1+r)(a-\alpha)}\left|\hat{\alpha}-\alpha\right| \nonumber \\
\leq&S_t(1+r)^\alpha\log(1+r)e^{\log(1+r)\frac{\sqrt{B}}{t^{\frac{\alpha}{2}}}}\frac{\sqrt{B}}{t^{\frac{\alpha}{2}}}\leq c_1\cdot S_t(1+r)^\alpha \frac{\log(1+r)}{t^{\frac{\alpha}{2}}}, \label{eq:wrong_alpha}
\end{align}
where $c_1:=\sqrt{B}e^{2c_0\sqrt{B}}$.
For the second term of \eqref{eq:split1}, we make some preliminary observations. Note that
$$(1+r)^{\alpha}\IE(S_t^*)=c\Gamma(1-\alpha)((1+r)t)^{\alpha}=c\Gamma(1-\alpha)T^{\alpha}=\IE(S_T^*),$$
because $T=(1+r)t$.
Hence, by using Corollary~\ref{cor: Laplace neo} in the same way as in the proof of Theorem~\ref{thm: alpha-rate}, we get
\begin{align*}
\left|\IE(S_t)(1+r)^{\alpha}-\IE(S_T)\right|\leq&(1+r)^{\alpha}\left|\IE(S_t)-\IE(S_t^*)\right|+\left|\IE(S_T^*)-\IE(S_T)\right| \\
\leq&K\Gamma\left(1-\frac{\alpha}{2}\right)\left((1+r)^{\alpha}+(1+r)^{\frac{\alpha}{2}}\right)t^{\frac{\alpha}{2}} \\
=&O\left((1+r)^{\alpha}t^{\frac{\alpha}{2}}\right).
\end{align*}
Using the above and Estimate~\eqref{eq:rate_St}, we estimate the second term of Equation~\eqref{eq:split1} by
\begin{align}
&\left|\left(S_t(1+r)^{\alpha}-S_T\right)\right| \nonumber \\
\leq&\left|(1+r)^{\alpha}(S_t-\IE(S_t))\right|+\left|\IE(S_t)(1+r)^{\alpha}-\IE(S_T)\right|+\left|\IE(S_T)-S_T\right| \nonumber \\
=&O_P\left((1+r)^{\alpha}t^{\frac{\alpha}{2}}\right)+O\left((1+r)^{\alpha}t^{\frac{\alpha}{2}}\right)+ O_P\left(T^{\frac{\alpha}{2}}\right) \nonumber \\
=&O_P\left((1+r)^{\alpha}t^{\frac{\alpha}{2}}\right). \label{eq:correct_upscaling}
\end{align}
Now, we use Inequality~\eqref{eq:wrong_alpha} in Inequality~\eqref{eq:split1} to obtain
\begin{align*}
&\IP(E_n^c\cap A_n\cap B_n)=\IP\left(\ell_{\alpha}(\tilde{S}_{t,T},S_{t,T})>\frac{C\log^2(1+r)}{t^{\alpha}} \cap A_n \cap B_n\right) \\
\leq&\IP\left(\ell_{\alpha}(\hat{S}_{t,T},S_{t,T})>\frac{C\log^2(1+r)}{t^{\alpha}}\cap B_n\right) \\
=&\IP\left(\frac{1}{(rt)^{2\alpha}}\left|\hat{S}_{t,T}-S_{t,T}\right|^2>\frac{C\log^2(1+r)}{t^{\alpha}}, B_n\right) \\
\leq&\IP\Bigg(S_t(1+r)^\alpha\log(1+r)\sup_{a\in[\hat{\alpha},\alpha]}e^{\log(1+r)(a-\alpha)}\left|\hat{\alpha}-\alpha\right|+\left|\left(S_t(1+r)^{\alpha}-S_T\right)\right| \\
&\qquad>\frac{\sqrt{C}(rt)^{\alpha}\log(1+r)}{t^{\frac{\alpha}{2}}}, B_n\Bigg) \\
\leq&\IP\left(S_t(1+r)^\alpha\log(1+r)\sup_{a\in[\hat{\alpha},\alpha]}e^{\log(1+r)(a-\alpha)}\left|\hat{\alpha}-\alpha\right|>\frac{\sqrt{C}r^{\alpha}t^{\frac{\alpha}{2}}\log(1+r)}{2}, B_n\right) \\
&+\IP\left(\left|\left(S_t(1+r)^{\alpha}-S_T\right)\right|>\frac{\sqrt{C}r^{\alpha}t^{\frac{\alpha}{2}}\log(1+r)}{2}\right) \\
\leq&\IP\left(c_1S_t(1+r)^\alpha t^{-\frac{\alpha}{2}}>\frac{\sqrt{C}r^{\alpha}t^{\frac{\alpha}{2}}}{2}\right) \\
&\qquad+\IP\left(\left|\left(S_t(1+r)^{\alpha}-S_T\right)\right|>\frac{\sqrt{C}r^{\alpha}t^{\frac{\alpha}{2}}\log(1+r)}{2}\right) \\
\leq&\IP\left(S_t(1+r)^\alpha>\frac{\sqrt{C}(rt)^{\alpha}}{2c_1}\right) \\
&\qquad+\IP\left(\left|\left(S_t(1+r)^{\alpha}-S_T\right)\right|>\frac{\sqrt{C}r^{\alpha}t^{\frac{\alpha}{2}}\log(1+r)}{2}\right).
\end{align*}
By Equations~\eqref{eq:correct_upscaling} and~\eqref{eq:ESt_bound}, we find that we can choose $C>0$ such that the above is smaller than $\frac{\epsilon}{3}$.

We turn lastly to the probability $\IP(E_n^c\cap A_n^c)$. In this case, $\tilde{S}_{t,T}=0$ and $\log(1+r)>c_0t^{\frac{\hat{\alpha}_n}{2}}$.
Hence,
\begin{align*}
&\IP(E_n^c\cap A_n^c\cap B_n)=\IP\left(\ell_{\alpha}(\tilde{S}_{t,T},S_{t,T})>\frac{C\log^2(1+r)}{t^{\alpha}}\cap A_n^c\cap B_n\right) \\
\leq&\IP\left(\frac{S_{t,T}^2}{(rt)^{2\alpha}}>Cc_0^2t^{\hat{\alpha}_n-\alpha}\cap B_n\right)=\IP\left(S_{t,T}>\sqrt{C}c_0r^{\alpha}t^{\frac{\hat{\alpha}_n+\alpha}{2}}\cap B_n\right).
\end{align*}
Now, on the event $B_n$, we have $\hat{\alpha}_n\geq\alpha-Bt^{-\frac{\alpha}{2}}$. Thus, we may continue the above inequality chain as follows
\begin{align}
&\IP(E_n^c\cap A_n^c\cap B_n)\leq\IP\left(S_{t,T}>\sqrt{C}c_0r^{\alpha}t^{\frac{\alpha-Bt^{-\frac{\alpha}{2}}+\alpha}{2}}\right) \nonumber \\
=&\IP\left(S_{t,T}>\sqrt{C}c_0(rt)^{\alpha}t^{\frac{-B}{2}t^{-\frac{\alpha}{2}}}\right). \label{eq:EncAncBn}
\end{align}
Since $S_{t,T}\leq S_T$ and $S_T=O_P((rt)^{\alpha})$ by Equation~\eqref{eq:ESt_bound} and
$$\log\left(t^{\frac{-B}{2}t^{-\frac{\alpha}{2}}}\right)=\frac{-B}{2}t^{-\frac{\alpha}{2}}\log\left(t\right)\to0$$
for $t\to\infty$, we find that the the probability in Equation~\eqref{eq:EncAncBn} can be bounded from above by $\frac{\epsilon}{3}$ for all $t$ larger than a certain $t_0$ and after possibly increasing $C$.

Hence, all probabilities in Equation~\eqref{eq:mainUB} can be bounded by $\frac{\epsilon}{3}$ for large enough $t$ and $C$.

Consider now the case $\log(1+r)>2c_0t^{\frac{\alpha}{2}}$. Now, on the event $B_n$, we have
$$\log(1+r)\geq2c_0t^{\frac{\alpha}{2}}=c_0t^{\frac{\hat{\alpha}_n}{2}}\cdot2t^{\frac{\alpha-\hat{\alpha}_n}{2}}\geq c_0t^{\frac{\hat{\alpha}_n}{2}}\cdot 2t^{-\frac{B}{2}t^{-\frac{\alpha}{2}}}.$$
Since $\lim_{t\to\infty}t^{-\frac{B}{2}t^{-\frac{\alpha}{2}}}=1$, we conclude that, on $B_n$, we have $\tilde{S}_{t,T}=0$ for $t$ large enough. Therefore, by using the same arguments as for $\IP(E_n^c\cap A_n^c\cap B_n)$,
\begin{align*}
\IP(E_n^c)\leq&\IP(E_n^c\cap B_n)+\IP(B_n^c) \\
\leq&\IP\left(\frac{S_{t,T}^2}{(rt)^{2\alpha}}>\frac{C\log^2(1+r)}{t^{\alpha}}\geq 4Cc_0^2\right)+\frac{\epsilon}{6} \\
\leq&\IP\left(S_T>\sqrt{C}2c_0(rt)^{\alpha}\right)+\frac{\epsilon}{6}.
\end{align*}
And, similarly as for Equation~\eqref{eq:EncAncBn}, by the behaviour of $S_T$, we have that the last probability can be made arbitrarily small after possibly increasing $C$.
\end{proof}

\section{Appendix 2: Data} \label{sec: Appendix 2: Data}
In this appendix we describe the real world data used and how it was processed.

\subsection{Butterflies}
We start with the large database of butterfly observation data in  \cite{yu_2025_spatial}. As the model does not account for time evolution of the distribution and geographically distinct sources we sought a subset of the data with many observations over a short time span in a small geographical area. Among those we picked one with a large number of observed species as we consider this the more interesting regime. ' In this way we settled on using data collected near coordinates (-5.25,145.27), Papua New Guinea between 2008-05-30" and 2008-07-29 by L. Sam and F. Kimbeng and staff the Binatang Research Center. We note that the high discovery regime is favorable for $\hat{S}_{t,T}^{(H^*)}$, this has some cherry-picking effect and one should not expect it to perform as well when applied to data collected in less ecologically diverse places.
\subsection{Messages}
We use the CollegeMsg temporal network data in \cite{panzarasa_2009_patterns}. Since most people sent many messages in the 193 days the data was collected, we sub-sample the data by a factor $100$. Our hope was also that this would help with exchangeability as it limits call-response dynamics.
\subsection{Magic the Gathering}
We simulated packs using \cite{joshbirnholz_2025_github}. The associated README claims that "packs are meant to have cards that match what you'd really find in booster packs from that set". Despite this we find it likely that the simulator does not reproduce all aspects of pack generation. For convenience and reproducibility our GitHub contains a text file with the generated packs.

\subsection{Genes}
We choose the same data set as the first example in \cite{daley_2014_modeling}, namely we test performance using sequence read archive session number SRX151616 which uses a MDA haploid library for single sperm sequencing. To limit computational cost the authors of \cite{daley_2014_modeling} use a binning approach. Because this interferes with the generalized unseen species structure we instead limit computational cost by restricting ourselves to the first $10^5$ locations on the genome. That is, for each fragment, we keep it only if hits this initial segment. Because the experiment, by design, covers most locations many times we keep only every 10th fragment to put us in a higher discovery regime.
