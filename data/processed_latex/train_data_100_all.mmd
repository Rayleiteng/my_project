The symmetric cost operator has the form

$$C_{sym}=6 I\otimes I-2\sum_{j=1}^3\left(\sigma_j\otimes \sigma_j^T\right)
=
\begin{pmatrix}
    4& 0& 0& -4\\
    0& 8& 0& 0\\
    0& 0& 8& 0\\
    -4& 0& 0& 4
\end{pmatrix}.$$

We use the standard basis $\ket{e_1}=(1,0,0,0)^T, \ket{e_2}=(0,1,0,0)^T, \ket{e_3}=(0,0,1,0)^T, \ket{e_4}=(0,0,0,1)^T:$

$$C_{\text{sym}}|_{\text{span}\{e_1,e_4\}}=\begin{pmatrix}
    4&-4\\-4&4
\end{pmatrix}=8\cdot \begin{pmatrix}
    1/2& -1/2\\ -1/2& 1/2
\end{pmatrix}, \qquad C_{\text{sym}}|_{\text{span}\{e_2,e_3\}}=8\cdot\begin{pmatrix}
    1&0\\0&1
\end{pmatrix}.$$

We can decompose the cost operator using the basis elements as

$$C_{\text{sym}}=8\ket{e_2}\bra{e_2}+8\ket{e_3}\bra{e_3}+8\left|\frac{1}{\sqrt{2}}(e_1-e_4)\right\rangle\left\langle\frac{1}{\sqrt{2}}(e_1-e_4)\right|=$$

$$=8\left|\frac{1}{\sqrt{2}}(e_2+e_3)\right\rangle\left\langle\frac{1}{\sqrt{2}}(e_2+e_3)\right|+8\left|\frac{1}{\sqrt{2}}(e_2-e_3)\right\rangle\left\langle\frac{1}{\sqrt{2}}(e_2-e_3)\right|+8\left|\frac{1}{\sqrt{2}}(e_1-e_4)\right\rangle\left\langle\frac{1}{\sqrt{2}}(e_1-e_4)\right|.$$


For $\mathcal{H}=\mathbb{C}^2$, set of the four Pauli matrices form a basis of $\mathcal{H}\otimes\mathcal{H}^*$. Using the standard basis $\ket{e_1}=(1,0), \ket{e_2}=(0,1)$ in $\mathcal{H}$, we can identify the basis elements with vectors with the help of the following isomorphism:


$$\text{Lin}(\mathcal{H})\longleftrightarrow \mathcal{H}\otimes\mathcal{H}^*:  \ket{x}\bra{y}\longleftrightarrow \ket{x}\otimes\bra{y}.$$

A standard basis for $\mathcal{H}\otimes\mathcal{H}^*$ is $\left\{ \ket{e_1}\otimes\bra{e_1}, \ket{e_1}\otimes\bra{e_2},\ket{e_2}\otimes\bra{e_1},\ket{e_2}\otimes\bra{e_2}\right\}$.


\[
\begin{aligned}
\sigma_0 &= \ket{e_1}\!\bra{e_1} + \ket{e_2}\!\bra{e_2}
&&\Longrightarrow\quad \ket{\!\ket{\sigma_0}} = (1,0,0,1)^{\mathrm T},\\[4pt]
\sigma_1 &= \ket{e_1}\!\bra{e_2} + \ket{e_2}\!\bra{e_1}
&&\Longrightarrow\quad \ket{\!\ket{\sigma_1}} = (0,1,1,0)^{\mathrm T},\\[4pt]
\sigma_2 &= -i\ket{e_1}\!\bra{e_2} + i\ket{e_2}\!\bra{e_1}
&&\Longrightarrow\quad \ket{\!\ket{\sigma_2}} = (0,-i,i,0)^{\mathrm T},\\[4pt]
\sigma_3 &= \ket{e_1}\!\bra{e_1} - \ket{e_2}\!\bra{e_2}
&&\Longrightarrow\quad \ket{\!\ket{\sigma_3}} = (1,0,0,-1)^{\mathrm T}.
\end{aligned}
\]
The form of the cost operator using this notation is

 $$C_{\text{sym}}=0\cdot\frac{1}{2}\ket{\ket{\sigma_0}}\bra{\bra{\sigma_0}}+8\cdot\left(\frac{1}{2}\cdot\sum_{j=1}^3\ket{\ket{\sigma_j}}\bra{\bra{\sigma_j}}\right).$$



\subsection{The $n$-qubit case $\cH=\C^{2^n}$}


 \begin{definition}[cost operator in $2^n$ dimensions]

$$C_{\text{sym}}^{(2^n)}=\sum_{j_1,\ldots,j_n=0}^3\left( (\sigma_{j_1}\otimes \ldots\otimes\sigma_{j_n})\otimes I_{2^n}^T-I_{2^n}\otimes (\sigma_{j_1}\otimes\ldots\otimes \sigma_{j_n})^T\right)^2$$


\end{definition}

\begin{claim}
    $$C_{\text{sym}}^{(2^n)}=\sum_{j_1,\ldots,j_n=0}^3((\sigma_{j_1}\otimes\ldots\otimes\sigma_{j_n})\otimes I_{2^n}-I_{2^n}\otimes(\sigma_{j_1}\otimes\ldots\otimes\sigma_{j_n}))^2=2\cdot4^n\cdot I_{2^{2n}}-2\cdot 4^n\cdot\frac{1}{2^n}\ket{\ket{I_{2^n}}}\bra{\bra{I_{2^n}}}.$$
\end{claim}

\begin{proof}

    We can justify the statement by checking the values taken by both handsides on the elements of a basis $\{\sigma_{k_1}\otimes\ldots\sigma_{k_n}\}_{k_1,\ldots,k_n=0}^3$ in $M_{2^n}(\mathbb{C}).$

    Let us start with the right-hand side.




    \[
\begin{aligned}
\Big(2\cdot4^n I_{2^{2n}} &-2\cdot4^n\cdot\frac{1}{2^n}\,\ket{\!\ket{I_{2^n}}}\bra{\!\bra{I_{2^n}}}\Big)
\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}\\[6pt]
&=2\cdot4^n\,\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
-2\cdot4^n\cdot\frac{1}{2^n}\,
\operatorname{tr}\!\big[I_{2^n}^\dagger(\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n})\big]\,
\ket{\!\ket{I_{2^n}}}\\[6pt]
&=2\cdot4^n\,\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
-2\cdot4^n\cdot\frac{1}{2^n}\,\prod_{r=1}^n\operatorname{tr}(\sigma_{k_r})\,
\ket{\!\ket{I_{2^n}}}\\[6pt]
&=2\cdot4^n\,\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
-2\cdot4^n\cdot\frac{1}{2^n}\prod_{r=1}^n\big(2\delta_{k_r,0}\big)\,
\ket{\!\ket{I_{2^n}}}\\[6pt]
&=2\cdot4^n\Big(\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
-\delta_{k_1,0}\cdots\delta_{k_n,0}\,\ket{\!\ket{I_{2^n}}}\Big).
\end{aligned}
\]

Now we compute the left handside using the computational rule $A\otimes B^T\ket{\ket{X}}=\ket{\ket{ AXB}}.$



\[
\begin{aligned}
C_{\mathrm{sym}}^{(2^n)}\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
&=\sum_{j_1,\ldots,j_n=0}^3
\Big((\sigma_{j_1}\otimes\cdots\otimes\sigma_{j_n})\otimes I_{2^n}^T
- I_{2^n}\otimes(\sigma_{j_1}\otimes\cdots\otimes\sigma_{j_n})^T\Big)^2
\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}\\[6pt]
&=\sum_{j_1,\ldots,j_n=0}^3 2\Big(I_{2^n}\otimes I_{2^n}^T
-\sigma_{j_1}\otimes\cdots\otimes\sigma_{j_n}\otimes
\sigma_{j_1}^T\otimes\cdots\otimes\sigma_{j_n}^T\Big)
\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}\\[6pt]
&=2\cdot 4^n\,\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
-2\sum_{j_1,\ldots,j_n=0}^3
\ket{\!\ket{\sigma_{j_1}\sigma_{k_1}\sigma_{j_1}\otimes\cdots\otimes
\sigma_{j_n}\sigma_{k_n}\sigma_{j_n}}}\\[6pt]
&=2\cdot 4^n\,\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
-2\cdot 4^n\,\delta_{k_1,0}\cdots\delta_{k_n,0}\,\ket{\!\ket{I_{2^n}}}\\[6pt]
&=2\cdot 4^n\Big(\ket{\!\ket{\sigma_{k_1}\otimes\cdots\otimes\sigma_{k_n}}}
-\delta_{k_1,0}\cdots\delta_{k_n,0}\,\ket{\!\ket{I_{2^n}}}\Big).
\end{aligned}
\]

where we used the fact that 

$$\sum_{j=0}^3\sigma_j\sigma_k\sigma_j=\begin{cases}
    4I\quad \text{if } k=0\\ 0\quad \text{otherwise}.
\end{cases}$$

    
\end{proof}

\begin{corollary}
    

The inequality 

$$C_{\text{sym}}^{(2^n)}\le 2\cdot 4^n\cdot I_{2^{2n}}$$ holds, so 

$$\left(D_{\text{sym}}^{(2^n)}\right)^2(\varrho, \omega)\le 2\cdot 4^n$$ for any states $\varrho,\omega\in\mathcal{S}(\mathbb{C}^{2^n}).$


Moreover, $$\left(D_{\text{sym}}^{(2^n)}\right)^2(\varrho, \omega)=2\cdot 4^n\Longleftrightarrow \text{tr}\left[\pi\ket{\ket{ I_{2^n}}}\bra{\bra{ I_{2^n}}}\right]=0.$$

\end{corollary}



