\section{Autonomous parabolic equations}

\begin{lemma}\label{lem:normGt}
    Let $t > 0$ be given. For every $u \in L^q(0,t;X)$ and every $y_0 \in Y_q$, the equation
    \begin{equation*}
        y' + A y = u \quad \text{in } (0,t), \quad y(0) = y_0.
    \end{equation*}
    admits a unique solution 
    \begin{equation*}
        y \in \W^q(0,t;\DD, X) \embed C([0,t];Y_q).
    \end{equation*}
    The associated solution operator 
    $G_t : L^q(0,t;X) \times Y_q \to C([0,t];Y_q)$ is linear and bounded. 
    Moreover, there is a constant $C_T$ such that 
    \begin{equation*}
        \sup_{t\in [0,T]} \|G_t\|_{L(L^q(0,t;X) \times Y_q, C([0,t];Y_q))} \leq C_T.
    \end{equation*}     
\end{lemma}

\begin{proof}
    The existence and uniqueness of the solution is guaranteed by maximal parabolic regularity of $A$. 
    Using the linearity of the equation, we split $G_t$ in two parts, namely 
    \begin{equation*}
        G_t := K_t + \iota_t, 
    \end{equation*}
    where $K_t:  L^q(0,t;X) \to C([0,t];Y_q)$ is the solution operator to 
    \begin{equation*}
        y' + A y = u \quad \text{in } (0,t), \quad y(0) = 0, 
    \end{equation*}
    while $\iota_t: Y_q \to C([0,t];Y_q)$ is the solution operator to 
    \begin{equation*}
        y' + A y = 0 \quad \text{in } (0,t), \quad y(0) = y_0.
    \end{equation*}
    By applying translation and extension by zero, it is shown in \cite[Lemma~3.16]{HMRR09} 
    that the norm of $K_t$ does not increase if $t$ is decreased and thus 
    \begin{equation*}
        \sup_{t\in [0,T]} \|K_t\|_{L(L^q(0,t;X), C([0,t];Y_q))}
        \leq \|K_T\|_{L(L^q(0,t;X), C([0,t];Y_q))}.
    \end{equation*}     
    Concerning $\iota_t$, we first observe that
    \begin{equation*}
        \|e^{-tA}\|_{L(\DD, \DD)} \leq \|e^{-tA}\|_{L(X,X)},
    \end{equation*}
    since
    \begin{equation*}
    \begin{aligned}
        \|e^{-tA} x \|_{\DD}
        &= \|A e^{-tA} x\|_X\\
        &= \|e^{-tA} A x\|_X
        \leq \|e^{-tA} \|_{L(X,X)} \|A x\|_X
        = \|e^{-tA} \|_{L(X,X)} \|x\|_\DD
        \quad \forall\, x\in \DD.    
    \end{aligned}
    \end{equation*}        
    Via interpolation, this implies 
    \begin{equation*}
        \|e^{-tA}\|_{L(Y_q, Y_q)} \leq \|e^{-tA}\|_{L(X,X)} \leq M\, e^{\omega t},
    \end{equation*}
    with constants $M>0$ and $\omega \in \R$, where the last inequality is a consequence of $A$
    being the generator of an analytic semigroup. Thus we obtain
    \begin{equation*}
    \begin{aligned}
        \sup_{t\in [0,T]} \|\iota_t\|_{L(Y_q, C([0,t];Y_q))}
        = \sup_{t\in [0,T]} \max_{s\in [0,t]} \|e^{-sA}\|_{L(Y_q, Y_q)} \leq \max\{M, M e^{\omega T}\}.
    \end{aligned}
    \end{equation*}
\end{proof}

\begin{lemma}\label{lem:adjlip}
    For every $g\in C([0,T]; Y_q^*)$, the unique solution of the equation 
    \begin{equation}\label{eq:psigl}
        - \psi' + A^*\psi = g, \quad \psi(T) = 0,
    \end{equation}
    is Lipschitz continuous on $[0,T]$ with values in $\DD^*$ and satisfies 
    \begin{equation*}
        \|\psi\|_{C^{0,1}(0,T;\DD^*)} \leq C'\, \|g\|_{C([0,T];Y_q^*)}
    \end{equation*}
    with a constant $C' >0$ independent of $g$.
\end{lemma}

\begin{proof}
    Since $X^* \subset D(A^*) = \{v\in \DD^*: \|A^* v\|_{\DD^*} < \infty\}$, there holds 
    according to \cite[Theorem~1.15.2(d)]{Tri78} that
    \begin{equation}\label{eq:triebel}
        Y_q^* = (\DD^*, X^*)_{1/q, q'}
        \embed (\DD^*, X^*)_{\theta, 1} 
        \embed (\DD^*, D(A^*))_{\theta, 1}
        \embed D((A^*)^\theta)
    \end{equation}
    for all $0 <\theta <1/q$.
    Therefore, $g\in C([0,T];D((A^*)^\theta))$ and consequently, by \cite[Theorem~4.3.6]{Paz83}, 
    the mild solution of \eqref{eq:psigl} given by 
    \begin{equation*}
        \psi(t) = \int_t^T e^{-(s - t)A^*}g(s)\,\d s 
    \end{equation*}
    is actually a classical solution, i.e., $\psi$ is continuous with values in $\DD^*$ on $[0,T)$,
    $\psi(t) \in X^*$ for all $t\in (0,T)$, and $\psi$ is continuously differentiable 
    with values in $\DD^*$ in $(0,T)$ and satisfies \eqref{eq:psigl} in all $t\in (0,T)$.
    Note that $A^*$ is the infinitesimal generator of an analytic semigroup, since it has maximal parabolic regularity 
    by Lemma~\ref{lem:maxparreg}\ref{it:maxparreg3}, cf.\ also \cite{Dor93}.
    This allows us to apply \cite[Theorem~6.13]{Paz83} to deduce
    \begin{equation*}
    \begin{aligned}
        \| A^* e^{-(s - t)A^*}g(s)\|_{\DD^*}
        &  =  \| (A^*)^{1-\theta} e^{-(s - t)A^*} (A^*)^\theta g(s) \|_{\DD^*} \\
        & \leq C\, |s-t|^{\theta - 1} \, \|(A^*)^\theta g(s) \|_{\DD^*}
        \leq C\, |s-t|^{\theta - 1} \, \| g(s)\|_{Y_q^*},
    \end{aligned}
    \end{equation*}        
    where we used \eqref{eq:triebel} for the last inequality. Since $\psi$ is a classical solution, it 
    satisfies \eqref{eq:psigl} pointwise in time and thus, we find for every $t\in (0,T)$ that
    \begin{equation*}
    \begin{aligned}
        \|\psi'(t)\|_{\DD^*} 
        & = \|A^* \psi(t) - g(t)\|_{\DD^*} \\
        & \leq \int_t^T \| A^* e^{-(s - t)A^*}g(s)\|_{\DD^*} \d s + \|g\|_{C([0,T];\DD^*)} \\
        & \leq C \int_t^T |s-t|^{\theta - 1}\,\d s\, \| g \|_{C([0,T]; Y_q^*)} + \|g\|_{C([0,T];\DD^*)} \\
        & \leq C ( T^\theta +1 ) \| g \|_{C([0,T]; Y_q^*)} .
    \end{aligned}
    \end{equation*}
    Thus, $\|\psi'(\cdot)\|_{\DD^*}$ is uniformly bounded on $(0,T)$ and consequently, 
    $\psi$ is Lipschitz continuous on the whole interval $[0,T]$ with Lipschitz constant $C(T^\theta + 1)$.
\end{proof}




	\section{Projection onto the polyhedron $\PP$}\label{sec:proj}
	
	The projection onto the feasible set $\PP$ is a well known problem in the literature, also known as 
	isotonic regression, see, e.g., \cite{Sal24}. 
    Nonetheless, for convenience of the reader, we present the proof of Theorem~\ref{theorem: projec} 
    in detail in this appendix. To this end, let us consider the minimizing problem associated with the 
	projection, i.e.,
    \begin{equation*}
    \begin{aligned}
        \Pi_{\PP}(\tau)
        = \argmin_{\mathfrak{t} \in \R^n} \Big\{ 
        \tfrac12 \| \mathfrak{t} - \tau\|_2^2 \; \colon \;
        0 \leq \mathfrak{t}_1 \leq \mathfrak{t}_2  
        \leq \ldots \leq  \mathfrak{t}_n \leq T \Big\} ,
    \end{aligned}
    \end{equation*}    	
    By convexity, Theorem \ref{theorem: projec} is proven if we can show that 
    \begin{equation}\label{eq:deftaustar}
    \begin{aligned}
        & \tau^* := \big(\max(\min(\hat{\tau}_j, T),0)\big)_{j = 1}^n
        = \big(\hat\tau_j - (\hat \tau_j)_- - (\hat \tau_j - T)_+\big)_{j = 1}^n \\[1ex]
        & \qquad\text{with} \quad 
        (\hat \tau_j)_- := \min\{\hat \tau_j , 0 \}, \quad (\hat \tau_j - T)_+ := \max \{ \hat \tau_j - T, 0 \}    
    \end{aligned}
    \end{equation}
    satisfies the associated necessary and sufficient optimality conditions, 
    which are equivalent to the existence of a Lagrange multiplier $\lambda^* \in \R^{n+1}$ such that
	\begin{gather}
		0 \leq \tau_1^* \leq \ldots \leq \tau_n^* \leq T, \label{KKT: feasibility}\\ 
		\tau^* - \tau + (\lambda_2^* - \lambda_1^*, \ldots, \lambda_{n+1}^* - \lambda_{n}^*) = 0, \label{KKT: gradient eq} \\
		\lambda_i^* (\tau_{i-1}^* - \tau_i^*) = 0, \quad \lambda_i^* \geq 0 
		\quad  \forall\, i = 1, \ldots, n+1, \label{KKT: complementarity} 
	\end{gather}
    where $\tau^*_0 := 0$ and $\tau^*_{n+1} := T$.
    	We first verify feasibility:
	
	\begin{lemma}\label{lem:taustarfeas}
		The point $\tau^*$ as defined in \eqref{eq:deftaustar} satisfies \eqref{KKT: feasibility}. 
	\end{lemma}
	
	\begin{proof}
		Let $m_1, m_2, \ldots, m_\ell \in \N$ be defined according to the iterative scheme from Algorithm~\ref{alg:proj}. 
		By construction of $\tau^*$ and $\hat\tau$, respectively, it is enough to show that 
		$\sigma_{m_{i-1}+1, m_i} \leq \sigma_{m_{i}+1, m_{i+1}}$ for $ i = 1, \ldots, \ell-1$. 
		We argue by contradiction and assume that $\sigma_{m_{i}+1, k} < \sigma_{m_{i-1}+1, m_i}$ 
		for some $k \geq m_{i}+1$. Then it follows that
		\begin{align*}
			\sigma_{m_{i-1}+1, k} &= \frac{m_i - m_{i-1}}{k-m_{i-1}} \sigma_{m_{i-1}+1, m_{i}} 
			+ \frac{k - m_{i}}{k-m_{i-1}} \sigma_{m_i +1, k} \\ 
			&< \frac{m_i - m_{i-1}}{k-m_{i-1}} \sigma_{m_{i-1}+1, m_{i}} + \frac{k - m_{i}}{k-m_{i-1}} \sigma_{m_{i-1}+1, m_{i}} 
			= \sigma_{m_{i-1}+1, m_{i}},
		\end{align*}
		which however contradicts the construction of $m_i$ in \eqref{eq:defmi}.
	\end{proof}
	
	\begin{lemma}\label{lemma: sum greater 0}
		Let $\hat \tau$ be as defined in \eqref{proj_scheme}. Then, it holds that
		\begin{equation*}
			\sum_{j = 1}^k \tau_j - \hat{\tau}_j \geq 0 \quad \forall\, k = 1, \ldots, n
			\quad \text{and} \quad
			\sum_{j = 1}^{m_i} \tau_j - \hat{\tau}_j = 0 \quad \forall\, i = 1, \ldots, \ell
		\end{equation*}
	\end{lemma}
	
	\begin{proof}
	    Let $k\in \{1, \ldots, n\}$ be arbitrary. Then, by construction of the iterative scheme in Algorithm~\ref{alg:proj}, 
	    there exists an index $i \in \{1, \ldots, \ell\}$ such that $m_{i-1}+1 \leq k \leq m_i$. 
	    It follows from \eqref{proj_scheme} and the construction of the $\sigma$-values as arithmetic means of $\tau$ that
		\begin{align*}
			\sum_{j = 1}^k \tau_j - \hat \tau_j 
			&= \sum_{r = 1}^{i-1} \sum_{j = m_{r-1}+1}^{m_r} (\tau_j - \hat \tau_j) + \sum_{j = m_{i-1}+1}^{k} (\tau_j - \hat \tau_j) \\
			&= \sum_{r = 1}^{i-1} \underbrace{\sum_{j = m_{r-1}+1}^{m_r} (\tau_j - \sigma_{m_{r-1}+1, m_r})}_{= 0} 
			+ \sum_{j = m_{i-1}+1}^{k} (\tau_j - \sigma_{m_{i-1}+1, m_i}) \\
			&= (k - m_{i-1}) ( \sigma_{m_{i-1}+1, k} - \sigma_{m_{i-1}+1, m_i}) \\
			&= (k - m_{i-1}) ( \sigma_{m_{i-1}+1, k} - \min_{m_{i-1}< j \leq n} \sigma_{m_{i-1}+1, j} ) \geq 0.
		\end{align*}
		If $k = m_i$, then the second addend in the above equality also vanishes and the claim follows. 
	\end{proof}
	
    In order to verify the remaining KKT conditions in \eqref{KKT: gradient eq}--\eqref{KKT: complementarity}, let us define
    the Lagrange multiplier as
	\begin{align}
		\lambda_1^* &:= - \sum_{j = 1}^n (\hat \tau_j)_- \geq 0, \label{def lambda 1} \\
		\lambda_i^* &:= \tau_{i-1} - \tau_{i-1}^* + \lambda_{i-1}^* 
		= \sum_{j = 1}^{i-1} (\tau_j - \tau_j^*) + \lambda_1^*, \quad i = 2, \ldots, n, 
		\label{def lambda i}\\
		\lambda_{n+1} &:= \sum_{j = 1}^n (\hat \tau_j - T)_+ \geq 0, \label{def lambda n+1}
	\end{align}
	where $(\hat \tau_j)_-$ and $(\hat \tau_j - T)_+$ are as defined in \eqref{eq:deftaustar}.
    Then \eqref{def lambda i} implies the first $n-1$ components of the gradient equation in \eqref{KKT: gradient eq} 
    and we only have to show that $\lambda_{n+1}^*- \lambda^*_n = \tau_n - \tau^*_n$. 
	This, however, follows immediatly from Lemma \ref{lemma: sum greater 0} along with the construction of 
	$\tau^*$ in \eqref{eq:deftaustar}, since 
	\begin{align*}
		\lambda_{n+1}^*- \lambda^*_n - (\tau_n - \tau_n^*) 
		&= \lambda_{n+1}^* - \sum_{j = 1}^n (\tau_i - \tau_i^*) - \lambda_1^* \\
		&= \sum_{j = 1}^n \big((\hat \tau_j - T)_+ + (\hat \tau_j)_- - \tau_j + \tau_j^*\big) \\
		&= \sum_{j = 1}^n (\hat \tau_j - \tau_j) = \sum_{j = 1}^{m_\ell} (\hat \tau_j - \tau_j) = 0.
	\end{align*}
	It remains to show the complementarity condition \eqref{KKT: complementarity}. 
	For all $i = 1, \ldots, n+1$, the definitions of $\lambda^*$ and $\tau^*$ imply
	\begin{align*}
		\lambda_i^* 

		&= \sum_{j = 1}^{i-1} (\tau_j - \hat \tau_j + (\hat \tau_j)_- + (\hat \tau_j - T)_+) - \sum_{j = 1}^n (\hat \tau_j)_- \\
		&= \sum_{j = 1}^{i-1} (\tau_j - \hat \tau_j)  - \sum_{j = i}^n (\hat \tau_j)_- + \sum_{j = 1}^{i-1} (\hat \tau_j - T)_+ . 
	\end{align*}
	where the case of $i = n+1$ follows from
    \begin{equation*}
        \sum_{j = 1}^{n} (\tau_j - \hat \tau_j) = \sum_{j = 1}^{m_\ell} (\tau_j - \hat \tau_j) = 0
    \end{equation*}    	
	by Lemma~\ref{lemma: sum greater 0}.
	By using this lemma again, 
	this implies the non-negativity of the Lagrange multiplier. 
	Moreover, if $\tau_i^* \neq \tau_{i-1}^*$, then the feasibility of $\tau^*$ by Lemma~\ref{lem:taustarfeas} implies 
	$\tau_i^* > \tau_{i-1}^*$ and consequently, the construction of $\tau^*$ in \eqref{eq:deftaustar} gives
	$0 \leq \tau_{i-1}^* < \tau_i^* \leq \hat \tau_i$, from which we deduce that $(\hat \tau_j)_- = 0$  
	for all $j \geq i$ and $(\hat \tau_j - T)_+ = 0$ for all $j < i$. 
	Furthermore, if $\tau_i^* \neq \tau_{i-1}^*$, then, by construction of $\tau^*$, there also holds that 
	$\hat\tau_i \neq \hat\tau_{i-1}$ and thus, the construction of $\hat\tau$  in \eqref{proj_scheme} in turn gives
	that $i-1 = m_r$ for some $r \in \{0, \ldots, l-1\}$. Consequently, Lemma \ref{lemma: sum greater 0}
	implies for the case $\tau_i^* \neq \tau_{i-1}^*$ that	
	\begin{align*}
		\lambda_i^* = 
		\sum_{j = 1}^{i-1} (\tau_j - \hat \tau_j) - \sum_{j = i}^n (\hat \tau_j )_- + \sum_{j = 1}^{i-1} (\hat \tau_j - T)_+
		= \sum_{j = 1}^{m_r} (\tau_j - \hat \tau_j) = 0,
	\end{align*}
	which is just the desired complementary slackness condition.

    
    
    
    \section{On the lack of differentiability of objectives involving point evaluations}\label{sec:nodiff}
    
    This section is devoted to an elementary example demonstrating the lack of differentiability of 
    objectives involving point evaluations in time. 
    We consider the probably most simple setting where 
    \begin{equation*}
        \DD = X = \R, \quad A = f \equiv 0, \quad n = 2,
    \end{equation*}
    which leads to the following ODE as state equation
    \begin{equation*}
        y' = \chi_{[\tau_1, \tau_2)} \psi_1, \quad y(0) = 0.
    \end{equation*}
    We first investigate an objective of the form
    \begin{equation}\label{eq:ptobj1}
        J(y, \tau) := g(y(\tau_2))
    \end{equation}        
    with a continuously differentiable function $g:\R \to \R$.    
    For a given couple of switching times $\tau = (\tau_1, \tau_2)$, $\tau_1, \tau_2 \in \R$,
    the unique solution of the ODE reads as follows: If $\tau_1 \leq \tau_2$, $\tau_2 > 0$, and $\tau_1 < T$, 
    then the solution equals the continuous function
    \begin{equation*}
        y_\tau(t) = 
        \begin{cases}
            0, & t < \tau_1, \\
            \psi_1 (t - \max\{\tau_1,0\}), & \tau_1 \leq t < \tau_2, \\
            \psi_1(\tau_2 - \max\{\tau_1,0\}), & \tau_2 \leq t \leq T,
        \end{cases}
        \qquad t \in [0,T].
    \end{equation*}
    If else $\tau_1 > \tau_2$ or $\tau_1 \leq \tau_2 \leq 0$ or $T \leq \tau_1 \leq \tau_2$, 
    then the solution is simply $y_\tau \equiv 0$.
    Let now $\bar\tau\in (0,T)$ and $h_2 \in \R$ be arbitrary and set 
    \begin{equation*}
        \tau = (\tau_1, \tau_2) = (\bar\tau,\bar\tau), \quad 
        h = (h_1, h_2) = (0, h_2).
    \end{equation*}
    Then we obtain 
    \begin{equation*}
    \begin{aligned}
        \frac{y_{\tau + h}(\tau_2 + h_2) - y_\tau(\tau_2)}{\|h\|}
        = 
        \begin{cases}
            0, & h_2 \leq 0, \\
            \psi_1, & h_2 > 0
        \end{cases} 
    \end{aligned}
    \end{equation*}
    and the chain rule for Hadamard differentiable functions implies for the directional derivative of the reduced objective
    \begin{equation*}
        J'(y_\tau, \tau; h) = 
        \begin{cases}
            0, & h_2 \leq 0,\\        
            g'(0)\psi_1, & h_2 >0,
        \end{cases}
    \end{equation*}
    illustrating that a reduced objective of the form \eqref{eq:ptobj1} as a function of $\tau$ only
    is in general indeed not differentiable.
    
    Similarly, an objective of type
    \begin{equation}\label{eq:ptobj2}
        J(y, \tau) := g(y(\hat \tau)
    \end{equation}
    with $g$ is as above and $\hat \tau \in[0,T]$ fixed is in general not differentiable.
    Indeed, if $\hat \tau > 0$, then we choose 
    \begin{equation*}
        \tau = (\tau_1, \tau_2) = (0, \hat \tau), \quad h = (0, h_2)
    \end{equation*}
    and a similar computation as above gives










    \begin{equation*}
        J'(y_\tau, \tau; h) = 
        \begin{cases}
            0, & h_2 \geq 0,\\        
            - g'(\psi_1\hat \tau)\psi_1, & h_2 < 0.
        \end{cases}
    \end{equation*}
    If $\hat\tau = 0$, then we set $\tau = (0,T)$ and $h = (h_1, 0)$ to obtain










    \begin{equation*}
        J'(y_\tau, \tau; h) = 
        \begin{cases}
            0, & h_1 \leq 0,\\        
            g'(0)\psi_1, & h_1 > 0
        \end{cases}
    \end{equation*}
    such that in both cases, $J$ is only directionally differentiable.

    \begin{remark}\label{rem:nodiff}
        The last example demonstrates that the replacement of $\chi_{[\tau_1, \tau_2)}$ by $\bar\chi_{[\tau_1, \tau_2)}$ 
        as defined in \eqref{eq:defbarchi} alone does not ensure differentiability, since $\tau_2 > \tau_1$ in this example and thus 
        $\chi_{[\tau_1, \tau_2)} = \bar\chi_{[\tau_1, \tau_2)}$.
        This illustrates that, even with this modification of $\chi_{[\tau_1, \tau_2)}$, the switching-point-to-state map is 
        in general not differentiable when considered as a mapping with values in $C([0,T])$. 
        This is in essence the reason for treating the state equation in weak form.
    \end{remark}

