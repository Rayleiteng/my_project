\title{Robust Policy Optimization to Prevent Catastrophic Forgetting}
\author[1]{Mahdi Sabbaghi\thanks{Correspondence can be made to: smahdi@seas.upenn.edu}}
\author[1]{George Pappas}
\author[2]{Adel Javanmard}
\author[1]{Hamed Hassani}

\affil[1]{University of Pennsylvania}
\affil[2]{University of Southern California}


