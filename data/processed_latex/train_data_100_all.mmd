\title{The Yang--Mills measure on compact surfaces as a \\ universal scaling limit of lattice gauge models}
\author{Nguyen Viet {\sc{Dang}\footnote{IRMA, Université de Strasbourg, 7 rue René Descartes, 67084 Strasbourg Cedex, France AND Institut Universitaire de France, Paris, France. Email : nvdang@unistra.fr} } and Elias \sc{Nohra}\footnote{Sorbonne Université, Université Paris Cité, CNRS, Laboratoire de Probabilités, Statistique et Modélisation, LPSM, F-75005, France. Email : elias.nohra@sorbonne-universite.fr}}
